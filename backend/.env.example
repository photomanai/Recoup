# Recoup backend — example environment.
# Copy to .env and fill real values:  cp .env.example .env
# NOTE: values below are TEST values. Never commit real passwords.

# MariaDB connection
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=Test1234!
DB_NAME=sla_monitor

# API host + port (harada dinləsin: 0.0.0.0 = bütün interfeyslər, 127.0.0.1 = yalnız local)
HOST=0.0.0.0
PORT=4000

# Login tokens (use a long random string in production)
JWT_SECRET=change-me-32-chars-minimum-secret-key

# Encrypts company Gmail App Passwords (64 hex chars = 32 bytes).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Monitor tick in seconds (30 production, 5-10 for demo)
MONITOR_INTERVAL_SEC=30

# Gmail SMTP (AI sender). Real sending needs a Gmail App Password
# entered per company on the Register page.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Vendor claim recipient (placeholder for MVP)
VENDOR_CLAIM_EMAIL=support@cloudflare.com

# log = print emails to console + DB only (safe demo). Remove to send real emails.
MAIL_MODE=log

# OpenRouter AI (drafts human-quality claim email bodies with FREE models).
# Get a key: https://openrouter.ai/keys — no key = static templates, nothing breaks.
OPENROUTER_API_KEY=
# Free router (auto-picks a free model) or pin one, e.g. meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=openrouter/free
